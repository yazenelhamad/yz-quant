# ---- Runtime ----
NODE_ENV=development
PORT=8787
# Public origin of the web app (used for cookies, CSRF and OAuth redirect URIs)
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787

# ---- Database ----
# Production: postgres://user:pass@host:5432/yzquant
# Development without a Postgres server: pglite://./data/pglite
DATABASE_URL=pglite://./data/pglite

# ---- Secrets (generate with: openssl rand -base64 32) ----
# Master key used to encrypt broker tokens and MFA secrets at rest (AES-256-GCM). Rotate with scripts/rotate-secrets.ts
SECRETS_MASTER_KEY=
# Session cookie signing key
SESSION_SECRET=

# ---- Robinhood Agentic Trading (official MCP) ----
# Defaults are the documented official endpoints. Override only if Robinhood changes them.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_OAUTH_REGISTER_URL=https://agent.robinhood.com/oauth/trading/register
ROBINHOOD_OAUTH_AUTHORIZE_URL=https://robinhood.com/oauth
ROBINHOOD_OAUTH_TOKEN_URL=https://api.robinhood.com/oauth2/token/

# ---- AI models (Anthropic). Leave blank => AI agents report "not configured" and the system fails closed. ----
ANTHROPIC_API_KEY=
MODEL_SLOW_BRAIN=claude-fable-5-1
MODEL_RESEARCH=claude-opus-5-5
MODEL_FAST=claude-haiku-4-5-20251001

# ---- Optional external market data providers (leave blank if unused) ----
POLYGON_API_KEY=

# ---- One-time headless setup (optional). When set and no users exist, https://<host>/setup creates the two users; it closes itself afterwards. ----
SETUP_TOKEN=

# ---- Password policy (defaults shown). Keep MFA on if you relax these. ----
PASSWORD_MIN_LENGTH=6
PASSWORD_MIN_CLASSES=2
